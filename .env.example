# 本地开发用的环境变量样板。
#
#   cp .env.example .env   然后填 JWT_SECRET
#
# .env 只在服务启动时加载(cmd/server/main.go),而且不覆盖已经存在的环境变量 ——
# shell 里 export 过的、容器注入的,都压过这个文件。
# 优先级:内置默认值 < configs/config.yaml < .env < 真实环境变量。
#
# 空值等于没设,会退回上一层。所以不想覆盖 YAML 的项,注释掉比留空更清楚。

# ---- 必填 ----

# HS256 签名密钥,至少 32 字节。只能从环境变量来 —— 写进 config.yaml 也不会被加载。
# 生成一个:openssl rand -base64 48
JWT_SECRET=

# ---- 选填,不填就用 configs/config.yaml 里的值 ----

# 不等于 production 就开 debug 日志和 gin DebugMode。
#APP_ENV=development

# 换配置文件/环境变量文件的位置,两个都是相对工作目录。
#CONFIG_PATH=configs/config.yaml
#ENV_PATH=.env

#HTTP_ADDR=:8080
#AGENT_ADDR=localhost:50051

# Agent 回调 /internal/tasks/:uid/callback 时带的共享密钥,放在 X-Internal-Token 头里。
# 至少 32 字节,而且**必须和 JWT_SECRET 是两个不同的值**。
# 不填的话 /internal 下的接口一律返回 500(不是放行),服务其余部分照常工作。
# 生成一个:openssl rand -base64 48
#AGENT_CALLBACK_SECRET=

# 本服务调 Agent 的 gRPC 接口时带的共享密钥,放在 metadata 的 x-agent-token 里。
# 注意方向和上面那个**相反**:AGENT_CALLBACK_SECRET 是 Agent 打过来,这个是打过去。
# Agent 那侧填同一个值到 MINI_AGENT_GRPC_TOKEN,两边必须一致。
#
# 至少 32 字节,而且不能等于 JWT_SECRET 或 AGENT_CALLBACK_SECRET ——
# 它们保护的是三条不同的路径,泄露一个不该把另外两个也交出去。
#
# 不填只在 Agent 绑回环地址(它的默认值)时才说得通:那种情况下它不鉴权。
# Agent 一旦往外绑而这边没填,它会拒绝启动。
# 生成一个:openssl rand -base64 48
#AGENT_GRPC_TOKEN=

# 带口令,所以生产环境走这里而不是 config.yaml。
#DB_DSN=host=localhost user=postgres password=123456 dbname=mini_agent_backend port=5432 sslmode=disable

# 签发方标识,会写进 iss 并在校验时核对。
#JWT_ISSUER=mini-agent

# 访问令牌有效期,"2h" / "30m" 这种写法。没有吊销机制,别配太长。
#JWT_ACCESS_TTL=2h

# 单个任务事件流的上限。到点整条流被掐断,任务会被标成 failed。
#AGENT_TASK_TIMEOUT=30m

# ---- 熔断 ----
# 连续多少次"下游有病"就把 Agent 隔离掉。0 = 关掉熔断(本地开发可以这么干)。
# 参数错、方法没实现这类不计数,否则一阵坏请求就能把健康的 Agent 关在门外。
#AGENT_BREAKER_THRESHOLD=5
# 熔断打开后等多久放一个探针出去。启用熔断时必须 > 0。
#AGENT_BREAKER_COOLDOWN=30s

# ---- 任务配额 ----
# 单个用户在一个滑动窗口内最多能建多少任务。设 0 关掉配额。
# 关掉意味着任何注册账号都能无限建任务 = 无限烧 LLM 额度,想清楚再关。
#TASK_QUOTA_MAX=200
# 统计窗口。启用配额时必须 > 0。
#TASK_QUOTA_WINDOW=24h

# ---- 任务回收器 ----
# 多久扫一次卡住的任务。设 0 关掉回收器(那样进程重启前派出去的任务会一直卡着)。
#RECONCILE_INTERVAL=1m
# 中间态任务多久没动静算卡住。比的是**两次事件之间的间隔**,不是任务总时长。
# 必须 >= RECONCILE_INTERVAL,否则刚建的任务下一轮就被判死。
#RECONCILE_STALE_AFTER=15m
# 一轮最多收几个,收不完下一轮接着来。
#RECONCILE_BATCH=100

# 注意:测试用的 TEST_DSN 不从这个文件读(测试不加载 .env),走 make test-db。
