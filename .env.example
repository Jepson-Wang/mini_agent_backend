# 本地开发用的环境变量样板。
#
#   cp .env.example .env   然后填 JWT_SECRET
#
# .env 只在服务启动时加载(cmd/server/main.go),而且不覆盖已经存在的环境变量 ——
# shell 里 export 过的、容器注入的,都压过这个文件。
# 优先级:内置默认值 < configs/config.yaml < .env < 真实环境变量。
#
# 空值等于没设,会退回上一层。所以不想覆盖 YAML 的项,注释掉比留空更清楚。

# ---- 必填 ----

# HS256 签名密钥,至少 32 字节。只能从环境变量来 —— 写进 config.yaml 也不会被加载。
# 生成一个:openssl rand -base64 48
JWT_SECRET=

# ---- 选填,不填就用 configs/config.yaml 里的值 ----

# 不等于 production 就开 debug 日志和 gin DebugMode。
#APP_ENV=development

# 换配置文件/环境变量文件的位置,两个都是相对工作目录。
#CONFIG_PATH=configs/config.yaml
#ENV_PATH=.env

#HTTP_ADDR=:8080
#AGENT_ADDR=localhost:50051

# 带口令,所以生产环境走这里而不是 config.yaml。
#DB_DSN=host=localhost user=postgres password=123456 dbname=mini_agent_backend port=5432 sslmode=disable

# 签发方标识,会写进 iss 并在校验时核对。
#JWT_ISSUER=mini-agent

# 访问令牌有效期,"2h" / "30m" 这种写法。没有吊销机制,别配太长。
#JWT_ACCESS_TTL=2h

# 注意:测试用的 TEST_DSN 不从这个文件读(测试不加载 .env),走 make test-db。
